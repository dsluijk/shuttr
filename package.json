{
  "name": "shuttr",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier -c --config .prettierrc **",
    "typecheck": "nuxt typecheck",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:generate:empty": "drizzle-kit generate --custom --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@unlazy/nuxt": "^2.0.1",
    "@vueuse/nuxt": "^14.4.0",
    "aws4fetch": "^1.0.20",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.2",
    "exifreader": "^4.42.0",
    "motion-v": "^2.3.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-authorization": "0.3.5",
    "p-limit": "^7.3.1",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "thumbhash": "^0.1.1",
    "uncrypto": "^0.1.3",
    "unstorage": "^1.17.5",
    "wcag-contrast": "^3.0.0",
    "zod": "^4.4.3"
