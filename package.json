    "@nuxt/devtools": "3.4.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/pg": "^8.21.0",
    "@types/wcag-contrast": "^3.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@10.18.3"
}
